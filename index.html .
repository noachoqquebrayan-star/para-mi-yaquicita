<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Para Jaqueline ❤️</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background-color: #05020a;
      overflow: hidden;
      color: #fff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    #canvas-container {
      width: 100vw;
      height: 100vh;
      position: absolute;
      top: 0;
      left: 0;
    }
    .header-title {
      position: absolute;
      top: 6%;
      width: 100%;
      text-align: center;
      font-size: 2.2rem;
      font-weight: bold;
      color: #ff4d8d;
      text-shadow: 0 0 15px #ff4d8d, 0 0 30px #ff0055;
      z-index: 10;
      pointer-events: none;
      padding: 0 10px;
    }
    .footer-subtitle {
      position: absolute;
      bottom: 5%;
      width: 100%;
      text-align: center;
      font-size: 1.2rem;
      color: #ffd1dc;
      text-shadow: 0 0 10px #ff4d8d;
      z-index: 10;
      pointer-events: none;
      padding: 0 10px;
    }
  </style>
</head>
<body>

  <div class="header-title" id="titulo-web">¡Feliz Cumpleaños, Jaqueline!</div>
  <div class="footer-subtitle" id="subtitulo-web">Eres mi universo entero ✨</div>
  <div id="canvas-container"></div>

  <!-- Librería Three.js para 3D -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
    // ============================================================
    // ⚙️ SECCIÓN DE CONFIGURACIÓN (Puedes editar los textos si deseas)
    // ============================================================
    
    const TITULO_SUPERIOR = "¡Feliz Cumpleaños, Jaqueline! ❤️";
    const SUBTITULO_INFERIOR = "Eres mi universo entero ✨";

    // Frases flotantes en la galaxia
    const frasesDeAmor = [
      "Te Amo",
      "Eres Magia",
      "Mi Persona Favorita",
      "Nuestro Universo",
      "Feliz Cumpleaños",
      "Para Siempre",
      "Jaqueline ❤️",
      "Mi Vida",
      "Te Adoro",
      "Siempre Juntos"
    ];

    // Nombres de las imágenes que subiste a GitHub
    const misFotos = [
      "foto1.jpg",
      "foto2.jpg",
      "foto3.jpg"
    ];

    // ============================================================
    // 🚀 LÓGICA DE LA GALAXIA 3D
    // ============================================================

    document.getElementById('titulo-web').innerText = TITULO_SUPERIOR;
    document.getElementById('subtitulo-web').innerText = SUBTITULO_INFERIOR;

    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 32;

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    container.appendChild(renderer.domElement);

    // 1. Estrellas de fondo
    const starsGeometry = new THREE.BufferGeometry();
    const starsCount = 2500;
    const starPositions = new Float32Array(starsCount * 3);
    for (let i = 0; i < starsCount * 3; i++) {
      starPositions[i] = (Math.random() - 0.5) * 200;
    }
    starsGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const starsMaterial = new THREE.PointsMaterial({ color: 0xffffff, size: 0.3 });
    const starField = new THREE.Points(starsGeometry, starsMaterial);
    scene.add(starField);

    // 2. Corazón Central de Partículas
    const heartGeometry = new THREE.BufferGeometry();
    const heartParticles = 1800;
    const heartPositions = new Float32Array(heartParticles * 3);
    for (let i = 0; i < heartParticles; i++) {
      let t = Math.PI * (Math.random() * 2 - 1);
      let x = 16 * Math.pow(Math.sin(t), 3);
      let y = 13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t);
      let z = (Math.random() - 0.5) * 4;
      
      heartPositions[i*3] = x * 0.45;
      heartPositions[i*3+1] = y * 0.45;
      heartPositions[i*3+2] = z * 0.45;
    }
    heartGeometry.setAttribute('position', new THREE.BufferAttribute(heartPositions, 3));
    const heartMaterial = new THREE.PointsMaterial({ color: 0xff0055, size: 0.28, transparent: true, opacity: 0.9 });
    const heartMesh = new THREE.Points(heartGeometry, heartMaterial);
    scene.add(heartMesh);

    const orbitGroup = new THREE.Group();
    scene.add(orbitGroup);

    // 3. Crear Frases Flotantes
    function createTextTexture(text) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = 512;
      canvas.height = 128;
      ctx.fillStyle = "rgba(0,0,0,0)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.font = "Bold 36px sans-serif";
      ctx.fillStyle = "#ff80bf";
      ctx.textAlign = "center";
      ctx.shadowColor = "#ff0055";
      ctx.shadowBlur = 12;
      ctx.fillText(text, canvas.width / 2, canvas.height / 2 + 10);
      return new THREE.CanvasTexture(canvas);
    }

    const radius = 18;
    frasesDeAmor.forEach((phrase, index) => {
      const texture = createTextTexture(phrase);
      const spriteMaterial = new THREE.SpriteMaterial({ map: texture, transparent: true });
      const sprite = new THREE.Sprite(spriteMaterial);
      
      const angle = (index / frasesDeAmor.length) * Math.PI * 2;
      sprite.position.x = Math.cos(angle) * radius;
      sprite.position.z = Math.sin(angle) * radius;
      sprite.position.y = (Math.random() - 0.5) * 8;
      sprite.scale.set(10, 2.5, 1);
      
      orbitGroup.add(sprite);
    });

    // 4. Cargar Fotos en Órbita
    const textureLoader = new THREE.TextureLoader();
    misFotos.forEach((fotoUrl, index) => {
      textureLoader.load(
        fotoUrl,
        (texture) => {
          const material = new THREE.SpriteMaterial({ map: texture, transparent: true });
          const sprite = new THREE.Sprite(material);
          
          const angle = (index / misFotos.length) * Math.PI * 2 + 0.5;
          const photoRadius = 14;
          sprite.position.x = Math.cos(angle) * photoRadius;
          sprite.position.z = Math.sin(angle) * photoRadius;
          sprite.position.y = (Math.random() - 0.5) * 6;
          sprite.scale.set(4, 4, 1);
          
          orbitGroup.add(sprite);
        },
        undefined,
        () => {
          // Si no hay foto cargada, continúa sin mostrar errores
        }
      );
    });

    // Animación
    function animate() {
      requestAnimationFrame(animate);
      
      heartMesh.rotation.y += 0.005;
      orbitGroup.rotation.y += 0.003;
      starField.rotation.y -= 0.0005;

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
